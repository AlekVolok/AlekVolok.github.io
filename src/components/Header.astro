---
import { site } from '../data/site.js';

const nav = [
  { href: '/work', label: 'Work' },
  { href: '/graphs', label: 'Graphs' },
  { href: '/blog', label: 'Blog' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header">
  <div class="rail">
    <div class="island">
      <a href="/" class="logo" aria-label={`${site.name} — home`}>
        <span class="logo-mark" aria-hidden="true"></span>
        <span class="logo-text">{site.name.split(' ')[0]}<em>{site.name.split(' ')[1]}</em></span>
      </a>

      <nav class="desk-nav" aria-label="Primary">
        {nav.map((item) => (
          <a href={item.href} class:list={['nav-link', { active: path.startsWith(item.href) }]}>
            {item.label}
          </a>
        ))}
      </nav>

      <a href="#contact" class="island-cta">
        Contact
        <span class="cta-well" aria-hidden="true">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 12L12 4M12 4H6M12 4v6" />
          </svg>
        </span>
      </a>

      <button
        class="burger"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="bar bar-1"></span>
        <span class="bar bar-2"></span>
      </button>
    </div>
  </div>
</header>

<div class="overlay" id="mobile-menu" hidden data-menu-panel>
  <nav class="overlay-nav" aria-label="Mobile">
    {nav.map((item, i) => (
      <a href={item.href} class="overlay-link" style={`--i:${i}`}>
        <span class="idx">0{i + 1}</span>
        {item.label}
      </a>
    ))}
    <a href="#contact" class="overlay-link" style={`--i:${nav.length}`}>
      <span class="idx">0{nav.length + 1}</span>
      Contact
    </a>
  </nav>
  <div class="overlay-foot" style={`--i:${nav.length + 1}`}>
    <a href={site.github} target="_blank" rel="noopener">GitHub</a>
    <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
  </div>
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    pointer-events: none;
  }
  /* The island floats, detached from the very top edge */
  .rail {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 22px var(--sp-6) 0;
    display: flex;
    justify-content: center;
  }
  .island {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    padding: 7px 7px 7px 20px;
    border-radius: 999px;
    background: rgba(10, 10, 12, 0.62);
    border: 1px solid var(--hairline);
    box-shadow: var(--inner-light), 0 18px 50px rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(26px) saturate(160%);
    -webkit-backdrop-filter: blur(26px) saturate(160%);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .logo em { font-style: normal; color: var(--text-dim); margin-left: 5px; }
  .logo-mark {
    width: 9px;
    height: 9px;
    border-radius: 3px;
    background: var(--accent);
    box-shadow: 0 0 14px var(--accent-glow);
    transition: transform var(--dur) var(--ease-fluid);
  }
  .logo:hover .logo-mark { transform: rotate(45deg) scale(1.15); }

  .desk-nav { display: flex; align-items: center; gap: 2px; }
  .nav-link {
    position: relative;
    color: var(--text-dim);
    font-size: 0.88rem;
    font-weight: 450;
    padding: 8px 14px;
    border-radius: 999px;
    transition: color var(--dur-fast) var(--ease-fluid),
      background var(--dur-fast) var(--ease-fluid);
  }
  .nav-link:hover { color: var(--text); background: rgba(255, 255, 255, 0.05); }
  .nav-link.active { color: var(--text); }
  .nav-link.active::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 2px;
    width: 3px;
    height: 3px;
    border-radius: 999px;
    background: var(--accent);
    transform: translateX(-50%);
    box-shadow: 0 0 8px var(--accent);
  }

  /* Nested CTA: label + its own circular icon well, flush to the pill edge */
  .island-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 5px 5px 5px 18px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 0.87rem;
    font-weight: 560;
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.4);
    transition: background var(--dur-fast) var(--ease-fluid),
      transform var(--dur-fast) var(--ease-fluid);
  }
  .island-cta:hover { background: var(--accent-hi); text-decoration: none; }
  .island-cta:active { transform: scale(0.98); }
  .cta-well {
    width: 27px;
    height: 27px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(4, 33, 28, 0.15);
    transition: transform var(--dur-fast) var(--ease-fluid),
      background var(--dur-fast) var(--ease-fluid);
  }
  .island-cta:hover .cta-well {
    transform: translate(2px, -2px) scale(1.06);
    background: rgba(4, 33, 28, 0.24);
  }
  .cta-well svg { width: 12px; height: 12px; }

  /* Hamburger — two bars that morph into a true X */
  .burger {
    display: none;
    position: relative;
    width: 42px;
    height: 42px;
    border-radius: 999px;
    border: 1px solid var(--hairline);
    background: rgba(255, 255, 255, 0.05);
    cursor: pointer;
  }
  .bar {
    position: absolute;
    left: 50%;
    width: 16px;
    height: 1.5px;
    border-radius: 2px;
    background: var(--text);
    transition: transform 600ms var(--ease-fluid), opacity 300ms var(--ease-fluid);
  }
  .bar-1 { transform: translate(-50%, -4px); }
  .bar-2 { transform: translate(-50%, 4px); }
  .burger[aria-expanded='true'] .bar-1 { transform: translate(-50%, 0) rotate(45deg); }
  .burger[aria-expanded='true'] .bar-2 { transform: translate(-50%, 0) rotate(-45deg); }

  /* Full-screen glass overlay */
  .overlay {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--sp-8);
    padding: 120px var(--sp-5) var(--sp-8);
    background: rgba(5, 5, 5, 0.82);
    backdrop-filter: blur(40px) saturate(150%);
    -webkit-backdrop-filter: blur(40px) saturate(150%);
    opacity: 0;
    transition: opacity 500ms var(--ease-fluid);
  }
  .overlay[hidden] { display: none; }
  .overlay.is-open { opacity: 1; }

  .overlay-nav { display: flex; flex-direction: column; }
  .overlay-link {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding: 14px 0;
    border-bottom: 1px solid var(--hairline);
    color: var(--text);
    font-family: var(--font-display);
    font-size: clamp(2rem, 11vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    /* staggered mask reveal */
    opacity: 0;
    transform: translateY(48px);
    transition: opacity 600ms var(--ease-fluid), transform 600ms var(--ease-fluid);
  }
  .overlay-link .idx {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent);
    letter-spacing: 0.1em;
  }
  .overlay.is-open .overlay-link {
    opacity: 1;
    transform: none;
    transition-delay: calc(120ms + var(--i) * 70ms);
  }
  .overlay-link:hover { text-decoration: none; color: var(--accent); }

  .overlay-foot {
    display: flex;
    gap: var(--sp-5);
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 600ms var(--ease-fluid), transform 600ms var(--ease-fluid);
  }
  .overlay.is-open .overlay-foot {
    opacity: 1;
    transform: none;
    transition-delay: calc(160ms + var(--i) * 70ms);
  }
  .overlay-foot a { color: var(--text-dim); font-size: 0.9rem; }
  .overlay-foot a:hover { color: var(--accent); }

  @media (max-width: 860px) {
    .desk-nav, .island-cta { display: none; }
    .burger { display: block; }
    .island { gap: var(--sp-4); padding: 6px 6px 6px 18px; }
    .rail { padding-top: 14px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .overlay-link, .overlay-foot { opacity: 1; transform: none; }
  }
</style>

<script is:inline>
  (() => {
    const btn = document.querySelector('[data-menu-toggle]');
    const panel = document.querySelector('[data-menu-panel]');
    if (!btn || !panel) return;

    let open = false;

    const setOpen = (next) => {
      open = next;
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) {
        panel.hidden = false;
        // next frame so the transition has a starting state to animate from
        requestAnimationFrame(() => panel.classList.add('is-open'));
      } else {
        panel.classList.remove('is-open');
        const done = () => { if (!open) panel.hidden = true; };
        panel.addEventListener('transitionend', done, { once: true });
        setTimeout(done, 600);
      }
    };

    btn.addEventListener('click', () => setOpen(!open));
    panel.addEventListener('click', (e) => {
      if (e.target.closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && open) { setOpen(false); btn.focus(); }
    });
    window.matchMedia('(min-width: 861px)').addEventListener('change', (e) => {
      if (e.matches && open) setOpen(false);
    });
  })();
</script>
