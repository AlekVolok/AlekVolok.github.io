---
interface Props {
  project: {
    title: string;
    description: string;
    tags: string[];
    link?: string;
  };
  index?: number;
}
const { project, index = 0 } = Astro.props;
const isExternal = project.link?.startsWith('http');
---

<article class="bezel interactive reveal" style={`--i:${index}`}>
  <div class="core">
    <div class="body">
      <header class="top">
        <h3>
          {project.link ? (
            <a
              href={project.link}
              target={isExternal ? '_blank' : undefined}
              rel={isExternal ? 'noopener' : undefined}
            >
              {/* stretched link makes the whole card a single hit target */}
              <span class="stretch"></span>
              {project.title}
            </a>
          ) : (
            project.title
          )}
        </h3>
        {project.link && (
          <span class="well" aria-hidden="true">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 12L12 4M12 4H6M12 4v6" />
            </svg>
          </span>
        )}
      </header>
      <p>{project.description}</p>
      <div class="tags">
        {project.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    </div>
  </div>
</article>

<style>
  .bezel { height: 100%; }
  .body {
    height: 100%;
    padding: var(--sp-5);
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }
  .top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--sp-4);
  }
  h3 {
    font-size: var(--fs-h3);
    line-height: 1.2;
  }
  h3 a { color: inherit; }
  h3 a:hover { text-decoration: none; }
  .stretch { position: absolute; inset: 0; z-index: 1; }
  .well {
    width: 30px;
    height: 30px;
    flex: none;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--hairline);
    color: var(--text-dim);
    transition: transform var(--dur) var(--ease-fluid),
      background var(--dur) var(--ease-fluid), color var(--dur) var(--ease-fluid);
  }
  .well svg { width: 12px; height: 12px; }
  .bezel:hover .well,
  .bezel:focus-within .well {
    transform: translate(2px, -2px) scale(1.06);
    background: var(--accent);
    color: var(--accent-ink);
  }
  p {
    color: var(--text-dim);
    font-size: 0.92rem;
    line-height: 1.6;
    flex: 1;
  }
</style>
