---
import Base from '../layouts/Base.astro';
---

<Base title="404">
  <section class="notfound">
    <div class="container">
      <span class="eyebrow reveal"><span class="dot"></span>Error 404</span>
      <h1 class="reveal" style="--i:1">Nothing<br /><em>here</em>.</h1>
      <p class="reveal" style="--i:2">
        The page you're looking for doesn't exist, or it moved somewhere else.
      </p>
      <div class="reveal" style="--i:3">
        <a href="/" class="btn primary has-icon">
          Back home
          <span class="btn-icon" aria-hidden="true">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 12L12 4M12 4H6M12 4v6" />
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .notfound {
    min-height: 100dvh;
    display: flex;
    align-items: center;
    padding: 180px 0 var(--section-y);
  }
  h1 {
    font-size: var(--fs-display);
    letter-spacing: -0.04em;
    margin: var(--sp-6) 0 var(--sp-5);
  }
  h1 em { font-style: normal; color: var(--accent); }
  p {
    color: var(--text-muted);
    font-size: var(--fs-lead);
    max-width: 44ch;
    margin-bottom: var(--sp-7);
  }
</style>
