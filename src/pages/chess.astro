---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Openings</title>
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#0a0c10" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script src="/register-sw.js" defer></script>
  </head>
  <body>
    <main class="game-page">
      <div class="game" id="game">
        <a class="mode-back" href="/words">← Learning modes</a>
        <div class="controls">
          <select id="openingSelect"></select>
          <select id="trainingModeSelect" aria-label="Training mode">
            <option value="learn">Learn · hints</option>
            <option value="challenge">Challenge · no hints</option>
          </select>
          <button id="reloadBtn" class="btn">Reload</button>
        </div>
        <div class="stats">
          <span id="score">Score: 0</span>
          <span id="mistakes">Mistakes: 0</span>
          <span id="multiplier">Multiplier: x1</span>
          <span id="accuracy">Accuracy: 100%</span>
          <span id="lineProgress">Line: 0/0</span>
          <span id="mastery">Mastery: new</span>
        </div>
        <div class="board-wrap">
          <div id="board" class="board"></div>
          <svg id="hintOverlay" viewBox="0 0 8 8" preserveAspectRatio="none">
            <defs>
              <marker id="arrowHead" viewBox="0 0 10 10" refX="8" refY="5"
                markerWidth="4" markerHeight="4" orient="auto-start-reverse">
                <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--accent)"></path>
              </marker>
            </defs>
          </svg>
          <div id="winOverlay" class="overlay" hidden>
            <p class="overlay-title">Line complete!</p>
            <p class="overlay-stats" id="finalStats"></p>
            <button id="playAgainBtn" class="btn">Play again</button>
            <p class="overlay-note">…or pick another opening above</p>
          </div>
        </div>
        <div class="under-board">
          <button id="hintBtn" class="btn">Hint</button>
          <span id="turnLabel"></span>
        </div>
        <p id="bookMoves" class="book-moves" aria-live="polite"></p>
        <section class="move-history" aria-label="Move history">
          <div class="move-history-head">
            <strong>Move history</strong>
            <span id="openingStatus"></span>
          </div>
          <div id="moveHistoryList" class="move-history-list">No moves yet</div>
        </section>
      </div>
      <dialog id="theoryDialog" class="theory-dialog">
        <button id="closeTheoryBtn" class="theory-close" type="button" aria-label="Закрыть">×</button>
        <p class="theory-kicker">Идея хода</p>
        <h2 id="theoryMove"></h2>
        <p id="theoryText"></p>
      </dialog>
    </main>
  </body>
</html>

<script>
  type Move = {
    from: string;
    to: string;
    san: string;
    rookFrom?: string;
    rookTo?: string;
    epCapture?: string;
    promotion?: string;
    children: Move[];
  };
  type Node = { children: Move[] };
  type VariationMove = Omit<Move, 'children'>;
  type Side = 'white' | 'black';

  const FILES = 'abcdefgh';
  const GLYPHS: Record<string, string> = {
    K: '♚︎',
    Q: '♛︎',
    R: '♜︎',
    B: '♝︎',
    N: '♞︎',
    P: '♟︎',
  };

  let board: Record<string, string> = {};
  let playerSide: Side = 'white';
  let currentNode: Node = { children: [] };
  let selectedSquare: string | null = null;
  let phase: 'player' | 'ai' | 'finished' | 'loading' = 'loading';
  let hintUsedThisMove = false;
  let gameId = 0;
  let score = 0;
  let mistakes = 0;
  let comboMultiplier = 1;
  let comboCount = 0;
  let currentOpeningSlug = '';
  let openingTheory: Record<string, Record<string, string>> = {};
  let moveHistory: string[] = [];
  let maxLineDepth = 0;
  let correctAttempts = 0;
  let totalAttempts = 0;
  let availableOpenings: { slug: string; label: string; side: Side }[] = [];
  type Mastery = Record<string, { completions: number; bestAccuracy: number }>;
  let mastery: Mastery = {};
  const masteryStorageKey = 'chess-opening-mastery-v1';

  const $ = <T extends Element>(sel: string) =>
    document.querySelector<T>(sel)!;

  const boardEl = $<HTMLDivElement>('#board');
  const openingSelect = $<HTMLSelectElement>('#openingSelect');
  const scoreEl = $<HTMLSpanElement>('#score');
  const mistakesEl = $<HTMLSpanElement>('#mistakes');
  const multiplierEl = $<HTMLSpanElement>('#multiplier');
  const accuracyEl = $<HTMLSpanElement>('#accuracy');
  const lineProgressEl = $<HTMLSpanElement>('#lineProgress');
  const masteryEl = $<HTMLSpanElement>('#mastery');
  const trainingModeSelect = $<HTMLSelectElement>('#trainingModeSelect');
  const hintBtn = $<HTMLButtonElement>('#hintBtn');
  const bookMovesEl = $<HTMLParagraphElement>('#bookMoves');
  const moveHistoryListEl = $<HTMLDivElement>('#moveHistoryList');
  const openingStatusEl = $<HTMLSpanElement>('#openingStatus');
  const hintOverlay = $<SVGSVGElement>('#hintOverlay');
  const winOverlay = $<HTMLDivElement>('#winOverlay');
  const finalStatsEl = $<HTMLParagraphElement>('#finalStats');
  const turnLabel = $<HTMLSpanElement>('#turnLabel');
  const theoryDialog = $<HTMLDialogElement>('#theoryDialog');
  const theoryMoveEl = $<HTMLHeadingElement>('#theoryMove');
  const theoryTextEl = $<HTMLParagraphElement>('#theoryText');

  function startPosition(): Record<string, string> {
    const pos: Record<string, string> = {};
    const back = ['R', 'N', 'B', 'Q', 'K', 'B', 'N', 'R'];
    for (let f = 0; f < 8; f++) {
      pos[`${FILES[f]}1`] = `w${back[f]}`;
      pos[`${FILES[f]}2`] = 'wP';
      pos[`${FILES[f]}7`] = 'bP';
      pos[`${FILES[f]}8`] = `b${back[f]}`;
    }
    return pos;
  }

  function addVariation(root: Node, variation: VariationMove[]) {
    let node = root;
    variation.forEach((move) => {
      let next = node.children.find((candidate) =>
        candidate.from === move.from && candidate.to === move.to
      );
      if (!next) {
        next = { ...move, children: [] };
        node.children.push(next);
      }
      node = next;
    });
  }

  function treeDepth(node: Node): number {
    if (node.children.length === 0) return 0;
    return 1 + Math.max(...node.children.map((child) => treeDepth(child)));
  }

  function loadMastery(): Mastery {
    try {
      const value = JSON.parse(localStorage.getItem(masteryStorageKey) ?? '{}');
      return value && typeof value === 'object' ? value : {};
    } catch {
      return {};
    }
  }

  function saveMastery() {
    try { localStorage.setItem(masteryStorageKey, JSON.stringify(mastery)); } catch {}
  }

  function recordMove(move: Move) {
    moveHistory.push(move.san);
    renderMoveHistory();
  }

  function renderMoveHistory() {
    if (moveHistory.length === 0) {
      moveHistoryListEl.textContent = 'No moves yet';
      return;
    }
    const turns: string[] = [];
    for (let index = 0; index < moveHistory.length; index += 2) {
      turns.push(`${index / 2 + 1}. ${moveHistory[index]}${moveHistory[index + 1] ? ` ${moveHistory[index + 1]}` : ''}`);
    }
    moveHistoryListEl.textContent = turns.join('  ');
  }

  function squareEl(sq: string) {
    return boardEl.querySelector<HTMLButtonElement>(`[data-square="${sq}"]`);
  }

  function renderBoard(lastMove?: { from: string; to: string }) {
    boardEl.innerHTML = '';
    const flip = playerSide === 'black';
    for (let row = 0; row < 8; row++) {
      for (let col = 0; col < 8; col++) {
        const file = flip ? 7 - col : col;
        const rank = flip ? row + 1 : 8 - row;
        const sq = `${FILES[file]}${rank}`;
        const btn = document.createElement('button');
        btn.className = `square ${(file + rank) % 2 === 0 ? 'dark' : 'light'}`;
        btn.dataset.square = sq;
        const piece = board[sq];
        if (piece) {
          btn.textContent = GLYPHS[piece[1]];
          btn.classList.add(piece[0] === 'w' ? 'wpiece' : 'bpiece');
        }
        if (lastMove && (sq === lastMove.from || sq === lastMove.to)) {
          btn.classList.add('last-move');
        }
        btn.addEventListener('click', () => onSquareClick(sq));
        boardEl.appendChild(btn);
      }
    }
  }

  function applyMove(m: Move) {
    if (m.epCapture) delete board[m.epCapture];
    board[m.to] = m.promotion
      ? board[m.from][0] + m.promotion.toUpperCase()
      : board[m.from];
    delete board[m.from];
    if (m.rookFrom && m.rookTo) {
      board[m.rookTo] = board[m.rookFrom];
      delete board[m.rookFrom];
    }
    clearHint();
    renderBoard({ from: m.from, to: m.to });
  }

  function flash(sq: string, cls: string) {
    const el = squareEl(sq);
    el?.classList.add(cls);
    setTimeout(() => el?.classList.remove(cls), 700);
  }

  function onSquareClick(sq: string) {
    if (phase !== 'player') return;
    if (selectedSquare === sq) {
      squareEl(sq)?.classList.remove('sel');
      selectedSquare = null;
      return;
    }
    const piece = board[sq];
    const own = piece && piece[0] === playerSide[0];
    if (!selectedSquare) {
      if (!own) return;
      selectedSquare = sq;
      squareEl(sq)?.classList.add('sel');
      return;
    }
    if (own) {
      squareEl(selectedSquare)?.classList.remove('sel');
      selectedSquare = sq;
      squareEl(sq)?.classList.add('sel');
      return;
    }
    const from = selectedSquare;
    selectedSquare = null;
    squareEl(from)?.classList.remove('sel');
    tryPlayerMove(from, sq);
  }

  function tryPlayerMove(from: string, to: string) {
    const m = currentNode.children.find((c) => c.from === from && c.to === to);
    if (m) {
      applyMove(m);
      recordMove(m);
      flash(to, 'flash-good');
      correctAttempts += 1;
      totalAttempts += 1;
      score += (trainingModeSelect.value === 'challenge' ? 12 : 8) * comboMultiplier;
      if (!hintUsedThisMove) {
        comboCount += 1;
        if (comboCount % 3 === 0) comboMultiplier += 1;
      }
      hintUsedThisMove = false;
      currentNode = m;
      updateUI();
      if (m.children.length === 0) {
        showWinScreen();
      } else {
        phase = 'ai';
        turnLabel.textContent = 'Opponent thinking…';
        const id = gameId;
        setTimeout(() => aiMove(id), 450);
      }
    } else {
      mistakes += 1;
      totalAttempts += 1;
      score -= 5;
      comboCount = 0;
      comboMultiplier = 1;
      flash(from, 'flash-bad');
      flash(to, 'flash-bad');
      showBookMoves();
      turnLabel.textContent = 'Try one of the book moves';
      updateUI();
    }
  }

  function aiMove(id: number) {
    if (id !== gameId || phase !== 'ai') return;
    const moves = currentNode.children;
    const m = moves[Math.floor(Math.random() * moves.length)];
    applyMove(m);
    recordMove(m);
    currentNode = m;
    if (m.children.length === 0) {
      showWinScreen();
    } else {
      phase = 'player';
      turnLabel.textContent = `Opponent played ${m.san} — your move`;
    }
  }

  let hintTimer: ReturnType<typeof setTimeout> | undefined;

  function clearHint() {
    clearTimeout(hintTimer);
    hintOverlay.querySelectorAll('line').forEach((line) => line.remove());
    bookMovesEl.textContent = '';
  }

  function drawMoveArrow(m: Move, index = 0) {
    const flip = playerSide === 'black';
    const coord = (sq: string) => {
      const f = FILES.indexOf(sq[0]);
      const r = Number(sq[1]) - 1;
      return { x: (flip ? 7 - f : f) + 0.5, y: (flip ? r : 7 - r) + 0.5 };
    };
    const a = coord(m.from);
    const b = coord(m.to);
    const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
    line.setAttribute('x1', String(a.x));
    line.setAttribute('y1', String(a.y));
    line.setAttribute('x2', String(b.x));
    line.setAttribute('y2', String(b.y));
    line.setAttribute('marker-end', 'url(#arrowHead)');
    line.style.opacity = String(Math.max(0.42, 0.9 - index * 0.2));
    hintOverlay.appendChild(line);
  }

  function showBookMoves(moves = currentNode.children) {
    clearHint();
    moves.slice(0, 3).forEach(drawMoveArrow);
    bookMovesEl.textContent = `Book moves: ${moves.slice(0, 3).map((move) => move.san).join(' · ')}`;
    hintUsedThisMove = true;
    hintTimer = setTimeout(clearHint, 4500);
  }

  function showHint() {
    if (phase !== 'player' || currentNode.children.length === 0) return;
    showBookMoves();
    const m = currentNode.children[0];
    const theoryKey = `${m.from}-${m.to}`;
    theoryMoveEl.textContent = m.san;
    theoryTextEl.textContent = openingTheory[currentOpeningSlug]?.[theoryKey]
      ?? 'Этот ход улучшает расположение фигур и помогает выполнить стратегические задачи дебюта.';
    if (theoryDialog.open) theoryDialog.close();
    theoryDialog.showModal();
  }

  function showWinScreen() {
    phase = 'finished';
    turnLabel.textContent = '';
    const accuracy = totalAttempts === 0 ? 100 : Math.round(correctAttempts / totalAttempts * 100);
    const openingMastery = mastery[currentOpeningSlug] ?? { completions: 0, bestAccuracy: 0 };
    mastery[currentOpeningSlug] = {
      completions: openingMastery.completions + 1,
      bestAccuracy: Math.max(openingMastery.bestAccuracy, accuracy)
    };
    saveMastery();
    finalStatsEl.textContent = `Score: ${score} · Accuracy: ${accuracy}% · ${moveHistory.length} plies`;
    winOverlay.hidden = false;
    updateUI();
  }

  async function loadOpening() {
    gameId += 1;
    phase = 'loading';
    score = 0;
    mistakes = 0;
    comboMultiplier = 1;
    comboCount = 0;
    correctAttempts = 0;
    totalAttempts = 0;
    moveHistory = [];
    renderMoveHistory();
    hintUsedThisMove = false;
    selectedSquare = null;
    winOverlay.hidden = true;
    clearHint();

    const requestedSlug = openingSelect.value;
    const slug = requestedSlug === '__random__'
      ? availableOpenings[Math.floor(Math.random() * availableOpenings.length)].slug
      : requestedSlug;
    currentOpeningSlug = slug;
    const [openingRes, sidelinesRes, theoryRes] = await Promise.all([
      fetch(`/chess/openings/${encodeURIComponent(slug)}.json`),
      fetch('/chess/sidelines.json'),
      fetch('/chess/theory.ru.json')
    ]);
    const data = await openingRes.json();
    const sidelines: Record<string, VariationMove[][]> = await sidelinesRes.json();
    openingTheory = await theoryRes.json();
    sidelines[slug]?.forEach((variation) => addVariation(data.root, variation));

    playerSide = data.side;
    currentNode = data.root;
    maxLineDepth = treeDepth(data.root);
    openingStatusEl.textContent = `${data.label} · as ${data.side}`;
    board = startPosition();
    renderBoard();
    updateUI();

    if (playerSide === 'black') {
      phase = 'ai';
      turnLabel.textContent = 'Opponent thinking…';
      const id = gameId;
      setTimeout(() => aiMove(id), 450);
    } else {
      phase = 'player';
      turnLabel.textContent = 'Your move';
    }
  }

  function updateUI() {
    scoreEl.textContent = `Score: ${score}`;
    mistakesEl.textContent = `Mistakes: ${mistakes}`;
    multiplierEl.textContent = `Multiplier: x${comboMultiplier}`;
    const accuracy = totalAttempts === 0 ? 100 : Math.round(correctAttempts / totalAttempts * 100);
    accuracyEl.textContent = `Accuracy: ${accuracy}%`;
    lineProgressEl.textContent = `Line: ${moveHistory.length}/${maxLineDepth}`;
    const openingMastery = mastery[currentOpeningSlug];
    masteryEl.textContent = openingMastery
      ? `Mastery: ${openingMastery.completions}× · best ${openingMastery.bestAccuracy}%`
      : 'Mastery: new';
    hintBtn.disabled = trainingModeSelect.value === 'challenge';
    scoreEl.classList.toggle('negative', score < 0);
    scoreEl.classList.toggle('high', score >= 1000);
  }

  async function init() {
    const res = await fetch('/chess/openings.json');
    const openings: { slug: string; label: string; side: Side }[] = await res.json();
    availableOpenings = openings;
    mastery = loadMastery();

    const randomOpt = document.createElement('option');
    randomOpt.value = '__random__';
    randomOpt.textContent = 'Random opening';
    openingSelect.appendChild(randomOpt);

    openings.forEach(({ slug, label, side }) => {
      const opt = document.createElement('option');
      opt.value = slug;
      opt.textContent = side === 'black' ? `${label} (as Black)` : label;
      openingSelect.appendChild(opt);
    });
    await loadOpening();
  }

  openingSelect.addEventListener('change', loadOpening);
  trainingModeSelect.addEventListener('change', loadOpening);
  $('#reloadBtn').addEventListener('click', loadOpening);
  $('#hintBtn').addEventListener('click', showHint);
  $('#closeTheoryBtn').addEventListener('click', () => theoryDialog.close());
  theoryDialog.addEventListener('click', (event) => {
    if (event.target === theoryDialog) theoryDialog.close();
  });
  $('#playAgainBtn').addEventListener('click', loadOpening);

  init();
</script>

<style>
  .mode-back {
    display: inline-block;
    margin-bottom: 16px;
    color: var(--text-dim);
    font: 0.85rem var(--font-mono);
    text-decoration: none;
  }
  .mode-back:hover { color: var(--accent); }

  .theory-dialog {
    width: min(440px, calc(100% - 32px));
    padding: 28px;
    color: var(--text);
    background: var(--bg-raised);
    border: 1px solid var(--accent);
    border-radius: 16px;
    box-shadow: 0 24px 80px rgb(0 0 0 / 45%);
  }
  .theory-dialog::backdrop {
    background: rgb(0 0 0 / 62%);
    backdrop-filter: blur(3px);
  }
  .theory-close {
    position: absolute;
    top: 10px;
    right: 14px;
    padding: 4px 8px;
    color: var(--text-dim);
    background: none;
    border: 0;
    font-size: 1.6rem;
    cursor: pointer;
  }
  .theory-kicker {
    margin: 0 0 6px;
    color: var(--accent);
    font: 0.75rem var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .theory-dialog h2 { margin: 0 0 12px; font-size: 1.8rem; }
  .theory-dialog p:last-child { margin: 0; color: var(--text-dim); line-height: 1.65; }

  .game-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px 24px;
  }

  .game {
    width: 100%;
    max-width: 560px;
  }

  .controls {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr) auto;
    gap: 10px;
    margin-bottom: 20px;
  }
  .controls select {
    background: var(--bg-raised);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 0.92rem;
    font-family: var(--font-sans);
    flex: 1;
  }
  .controls select:focus {
    outline: none;
    border-color: var(--accent);
  }

  .stats {
    display: flex;
    gap: 20px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-dim);
    margin-bottom: 24px;
  }
  #score.negative { color: #f08080; }
  #score.high { color: var(--accent); }

  .board-wrap {
    position: relative;
    container-type: inline-size;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }

  #hintOverlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  #hintOverlay :global(line) {
    stroke: var(--accent);
    stroke-width: 0.14;
    stroke-linecap: round;
    opacity: 0.85;
  }

  .overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.72);
    backdrop-filter: blur(3px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    text-align: center;
    padding: 24px;
  }
  .overlay[hidden] { display: none; }
  .overlay-title {
    font-family: var(--font-sans);
    font-size: 1.4rem;
    color: var(--accent);
    margin: 0;
  }
  .overlay-stats {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--text);
    margin: 0;
  }
  .overlay-note {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-dim);
    margin: 0;
  }

  .under-board {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 16px;
  }
  .book-moves {
    min-height: 20px;
    margin: 10px 0 0;
    color: var(--accent);
    font: 0.78rem/1.4 var(--font-mono);
  }
  .move-history {
    margin-top: 14px;
    padding: 14px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
  }
  .move-history-head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 9px;
    color: var(--text-dim);
    font: 0.74rem var(--font-mono);
  }
  .move-history-head strong { color: var(--text); font-weight: 600; }
  .move-history-list {
    max-height: 72px;
    overflow-y: auto;
    color: var(--text-dim);
    font: 0.82rem/1.65 var(--font-mono);
  }
  #hintBtn:disabled { opacity: 0.45; cursor: not-allowed; }
  #turnLabel {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-dim);
  }

  @media (max-width: 520px) {
    .controls { grid-template-columns: 1fr; }
    .stats { flex-wrap: wrap; gap: 12px; }
  }
</style>

<style is:global>
  .board {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    aspect-ratio: 1;
    width: 100%;
  }
  .board .square {
    appearance: none;
    border: none;
    margin: 0;
    padding: 0;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    font-size: 8.2cqw;
    line-height: 1;
    cursor: pointer;
    font-family: 'Segoe UI Symbol', 'Noto Sans Symbols 2', 'DejaVu Sans', sans-serif;
    transition: background 0.15s, box-shadow 0.15s;
  }
  .board .square.light { background: #4a4f58; }
  .board .square.dark { background: #31353c; }
  .board .square.wpiece {
    color: #e8e6e3;
    text-shadow: 0 0 2px #000;
  }
  .board .square.bpiece {
    color: #26262a;
    text-shadow: 0 0 2px rgba(255, 255, 255, 0.35);
  }
  .board .square.sel {
    box-shadow: inset 0 0 0 2px var(--accent);
    background: var(--accent-dim);
