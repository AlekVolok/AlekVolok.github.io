---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../data/site.js';
import { projects } from '../data/projects.js';

const featured = projects.filter((p) => p.featured);

const capabilities = [
  {
    n: '01',
    title: 'Procedural & Pipeline',
    body: 'Houdini tool development, HDAs, procedural asset generation, and Python pipelines that take repetitive work out of artists’ hands.',
  },
  {
    n: '02',
    title: 'Geometry & Data',
    body: 'Point clouds, volumes and meshes as data — NumPy/SciPy processing, skeleton extraction, and bridging DCC tools with scientific Python.',
  },
  {
    n: '03',
    title: 'Real-time Graphics',
    body: 'GLSL, raymarching and renderer internals — squeezing quality and frame time out of large real-time scenes.',
  },
];
---

<Base>
  <!-- Hero — massive display type, macro whitespace -->
  <section class="hero">
    <div class="container">
      <span class="eyebrow reveal"><span class="dot"></span>Available for work</span>

      <h1 class="reveal" style="--i:1">
        Technical<br />
        <em>Artist</em> &amp; Tools<br />
        Engineer
      </h1>

      <div class="hero-foot">
        <p class="lead reveal" style="--i:2">{site.tagline}</p>
        <div class="cta reveal" style="--i:3">
          <a href="/work" class="btn primary has-icon">
            View work
            <span class="btn-icon" aria-hidden="true">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 12L12 4M12 4H6M12 4v6" />
              </svg>
            </span>
          </a>
          <a href="/documents/Aleksandr_Kozlov_Senior_Technical_Artist_CV.pdf" class="btn has-icon" download>
            Get CV
            <span class="btn-icon" aria-hidden="true">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M8 3v8m0 0L4.5 7.5M8 11l3.5-3.5M3 13h10" />
              </svg>
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Bento: about + portrait + capabilities + graphs + contact -->
  <section class="section">
    <div class="container">
      <div class="bento">
        <!-- About, wide -->
        <div class="bezel cell about reveal">
          <div class="core">
            <div class="pad">
              <span class="cell-label">About</span>
              <p class="about-lead">
                Senior Technical Artist with <strong>10+ years</strong> building tools and
                pipelines for real-time 3D — procedural content in Houdini, performance
                work in Unreal, and lately machine learning and robotics.
              </p>
              <details class="more">
                <summary>
                  <span class="more-label">Read more</span>
                  <span class="more-well" aria-hidden="true">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round">
                      <path d="M4 6.5L8 10.5L12 6.5" />
                    </svg>
                  </span>
                </summary>
                <div class="more-body">
                  <p>I've worked on titles including PUBG Black Budget, Battlefield 2042, FIFA and King's Bounty II, focusing on the unglamorous but critical work of making large open worlds run fast without looking worse.</p>
                  <p>Over the past few years my focus has shifted toward the intersection of real-time engines and machine learning — applying deep learning to content optimization, and more recently moving that curiosity into physical systems. I'm currently building and training a LeRobot-based mobile manipulator (LeKiwi + Jetson Orin Nano Super), and experimenting with LLM agents controlling it through a custom MCP server.</p>
                  <p>This site is where I write up what I learn along the way — Houdini tricks, engine internals, ML experiments, and now robotics — mostly so future-me remembers how I solved something, and maybe useful to someone else too.</p>
                </div>
              </details>
            </div>
          </div>
        </div>

        <!-- Portrait -->
        <div class="bezel cell portrait reveal" style="--i:1">
          <div class="core">
            <img src="/images/about/about_photo.jpg" alt={`Portrait of ${site.name}`} width="640" height="800" />
            <div class="portrait-tag">
              <span class="name">{site.name}</span>
              <span class="role">{site.role}</span>
            </div>
          </div>
        </div>

        <!-- Capabilities -->
        {capabilities.map((c, i) => (
          <div class="bezel interactive cell cap reveal" style={`--i:${i}`}>
            <div class="core">
              <div class="pad">
                <span class="cap-n">{c.n}</span>
                <h3>{c.title}</h3>
                <p>{c.body}</p>
              </div>
            </div>
          </div>
        ))}

        <!-- Knowledge graphs teaser -->
        <a href="/graphs" class="bezel interactive cell graphs reveal">
          <div class="core">
            <div class="pad">
              <span class="cell-label">New</span>
              <h3>Knowledge graphs</h3>
              <p>
                A visual map of the tools and concepts I work with, and how they
                connect — procedural pipelines, geometry, ML and robotics.
              </p>
              <span class="link-arrow">
                Explore
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 12L12 4M12 4H6M12 4v6" />
                </svg>
              </span>
            </div>
            <svg class="graph-art" viewBox="0 0 200 120" aria-hidden="true" fill="none">
              <path d="M40 84L86 44M86 44l52 14M86 44l14-26M138 58l24-22M138 58l-6 34" stroke="rgba(94,234,212,0.3)" stroke-width="1" />
              <circle cx="40" cy="84" r="4" fill="#5eead4" opacity="0.9" />
              <circle cx="86" cy="44" r="6" fill="#5eead4" />
              <circle cx="138" cy="58" r="4.5" fill="#5eead4" opacity="0.75" />
              <circle cx="100" cy="18" r="3" fill="#8b7aff" opacity="0.8" />
              <circle cx="162" cy="36" r="3" fill="#8b7aff" opacity="0.6" />
              <circle cx="132" cy="92" r="3" fill="#5eead4" opacity="0.5" />
            </svg>
          </div>
        </a>

        <!-- Contact -->
        <div class="bezel cell contact reveal" style="--i:1">
          <div class="core">
            <div class="pad">
              <span class="cell-label">Contact</span>
              <ul>
                <li>
                  <span class="k">Email</span>
                  <a href={`mailto:${site.email}`}>{site.email}</a>
                </li>
                <li>
                  <span class="k">GitHub</span>
                  <a href={site.github} target="_blank" rel="noopener">AlekVolok</a>
                </li>
                <li>
                  <span class="k">LinkedIn</span>
                  <a href={site.linkedin} target="_blank" rel="noopener">aleksandr-kozlov</a>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured work -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <span class="eyebrow"><span class="dot"></span>Selected</span>
          <h2>Featured work</h2>
        </div>
        <a href="/work" class="link-arrow">
          All projects
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 12L12 4M12 4H6M12 4v6" />
          </svg>
        </a>
      </div>
      <div class="work-grid">
        {featured.map((p, i) => <ProjectCard project={p} index={i} />)}
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero ------------------------------------------------------------------ */
  /* Height comes from content, not the viewport — a min-height here would
     re-introduce dead space, just below the text instead of above it. */
  .hero {
    padding: clamp(126px, 14vh, 168px) 0 clamp(72px, 9vh, 104px);
  }
  /* The hero's own bottom padding is the whole separator — don't let the
     next section stack a second --section-y on top of it. */
  .hero + .section { padding-top: 0; }
  .hero h1 {
    font-size: var(--fs-display);
    margin: var(--sp-6) 0 var(--sp-8);
    letter-spacing: -0.04em;
  }
  .hero h1 em {
    font-style: normal;
    color: var(--accent);
  }
  .hero-foot {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: var(--sp-7);
    padding-top: var(--sp-6);
    border-top: 1px solid var(--hairline);
  }
  .lead {
    max-width: 46ch;
    color: var(--text-muted);
    font-size: var(--fs-lead);
    line-height: 1.55;
  }
  .cta { display: flex; gap: var(--sp-3); flex-wrap: wrap; }

  /* Bento ----------------------------------------------------------------- */
  .bento {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--sp-4);
  }
  .cell { display: block; color: inherit; }
  .about   { grid-column: span 7; }
  .portrait{ grid-column: span 5; }
  .cap     { grid-column: span 4; }
  .graphs  { grid-column: span 8; }
  .contact { grid-column: span 4; }

  .pad {
    padding: var(--sp-6);
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .cell-label {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--text-faint);
    margin-bottom: var(--sp-5);
  }

  .about-lead {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1rem + 1.1vw, 1.85rem);
    line-height: 1.28;
    letter-spacing: -0.025em;
    color: var(--text);
    flex: 1;
  }
  .about-lead strong { color: var(--accent); font-weight: 500; }

  .more { margin-top: var(--sp-6); }
  .more summary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    list-style: none;
    color: var(--text-muted);
    font-size: 0.88rem;
  }
  .more summary::-webkit-details-marker { display: none; }
  .more-well {
    width: 26px;
    height: 26px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--hairline);
    transition: transform var(--dur) var(--ease-fluid),
      background var(--dur) var(--ease-fluid);
  }
  .more-well svg { width: 12px; height: 12px; }
  .more summary:hover .more-well { background: rgba(255, 255, 255, 0.12); }
  .more[open] .more-well { transform: rotate(180deg); }
  .more-body {
    margin-top: var(--sp-5);
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    color: var(--text-dim);
    font-size: 0.94rem;
    line-height: 1.7;
  }

  /* Portrait -------------------------------------------------------------- */
  .portrait .core { position: relative; min-height: 340px; }
  .portrait img {
    width: 100%;
    height: 100%;
    min-height: 340px;
    object-fit: cover;
    object-position: center 22%;
  }
  .portrait-tag {
    position: absolute;
    left: var(--sp-4);
    right: var(--sp-4);
    bottom: var(--sp-4);
    padding: 13px 18px;
    border-radius: 999px;
    background: rgba(10, 10, 12, 0.6);
    border: 1px solid var(--hairline);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    display: flex;
    flex-direction: column;
  }
  .portrait-tag .name {
    font-family: var(--font-display);
    font-size: 0.95rem;
    letter-spacing: -0.02em;
  }
  .portrait-tag .role {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.13em;
    color: var(--text-dim);
  }

  /* Capability tiles ------------------------------------------------------- */
  .cap-n {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent);
    letter-spacing: 0.14em;
    margin-bottom: var(--sp-6);
  }
  .cap h3 { font-size: var(--fs-h3); margin-bottom: var(--sp-3); }
  .cap p { color: var(--text-dim); font-size: 0.9rem; line-height: 1.65; }

  /* Graphs teaser ---------------------------------------------------------- */
  .graphs .core { position: relative; }
  .graphs .pad { position: relative; z-index: 1; max-width: 58%; }
  .graphs h3 { font-size: clamp(1.4rem, 1.1rem + 1.2vw, 2rem); margin-bottom: var(--sp-3); }
  .graphs p { color: var(--text-dim); font-size: 0.92rem; margin-bottom: var(--sp-5); flex: 1; }
  .graphs:hover { text-decoration: none; }
  .graph-art {
    position: absolute;
    right: 4%;
    top: 50%;
    transform: translateY(-50%);
    width: 42%;
    max-width: 260px;
    transition: transform var(--dur) var(--ease-fluid);
  }
  .graphs:hover .graph-art { transform: translateY(-50%) scale(1.06); }

  /* Contact ---------------------------------------------------------------- */
  .contact ul { list-style: none; display: flex; flex-direction: column; gap: var(--sp-4); }
  .contact li { display: flex; flex-direction: column; gap: 2px; }
  .contact .k {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--text-faint);
  }
  .contact a { color: var(--text); font-size: 0.92rem; word-break: break-word; }
  .contact a:hover { color: var(--accent); text-decoration: none; }

  /* Work grid -------------------------------------------------------------- */
  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--sp-4);
  }

  /* Tablet ----------------------------------------------------------------- */
  @media (max-width: 1000px) {
    .about, .portrait, .graphs, .contact { grid-column: span 12; }
    .cap { grid-column: span 6; }
    .graphs .pad { max-width: 100%; }
    .graph-art { opacity: 0.4; }
  }

  /* Mobile — everything collapses to a single full-width column ------------- */
  @media (max-width: 768px) {
    .hero { padding-top: 130px; }
    .hero-foot { grid-template-columns: 1fr; align-items: start; gap: var(--sp-6); }
    .cta { width: 100%; }
    .bento { gap: var(--sp-3); }
    .cell, .cap { grid-column: span 12; }
    .pad { padding: var(--sp-5); }
    .graph-art { display: none; }
    .portrait .core, .portrait img { min-height: 300px; }
  }
</style>
