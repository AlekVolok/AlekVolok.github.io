---
import '../styles/global.css';
import { examDurationMinutes, examLength, passMark } from '../lib/knm.js';

const testNumbers = Array.from({ length: 26 }, (_, i) => i + 1);
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#050505" />
    <meta name="robots" content="noindex" />
    <title>Inburgering A2 · KNM</title>
  </head>
  <body>
    <main class="section knm-page">
    <div class="container knm-shell">
      <section id="intro" class="intro-card">
        <p class="eyebrow"><span class="dot"></span> Inburgering · A2</p>
        <h1>Kennis van de Nederlandse Maatschappij<br /><em>exam trainer</em></h1>
        <p class="lead">Welkom bij het voorbeeldexamen Kennis van de Nederlandse Maatschappij. U moet in dit voorbeeldexamen {examLength} vragen beantwoorden. Het echte examen KNM bestaat ook uit {examLength} vragen.</p>
        <div class="exam-rules">
          <span>01 {examLength} meerkeuzevragen</span>
          <span>02 {examDurationMinutes} minuten</span>
          <span>03 Geslaagd vanaf {passMark} goed</span>
          <span>04 Geen woordenboek</span>
        </div>
        <label class="test-select">
          <span>Oefenexamen</span>
          <select id="testChoice">
            <option value="">Willekeurig — 40 vragen uit alle 26 toetsen</option>
            {testNumbers.map((n) => <option value={n}>Oefentoets {String(n).padStart(3, '0')}</option>)}
          </select>
        </label>
        <button id="startExam" class="primary-button" type="button">Start oefenexamen <span>→</span></button>
        <p class="source-note">Opgaven: Knoester Trainingen, KNM oefenexamens 001–026 · dit is een oefentrainer, geen officieel DUO-examen. Sommige vragen kunnen verouderde regels bevatten.</p>
      </section>

      <section id="exam" class="exam" hidden aria-live="polite">
        <header class="exam-header">
          <div>
            <p class="kicker">A2 · Kennis Nederlandse Maatschappij</p>
            <strong id="progress">Vraag 1 van {examLength}</strong>
          </div>
          <div id="timer" class="timer" aria-label="Resterende tijd">{examDurationMinutes}:00</div>
        </header>

        <div class="progress-track" aria-hidden="true"><span id="progressBar"></span></div>

        <section class="question-card">
          <p class="question-label">Kies het beste antwoord</p>
          <h2 id="question"></h2>
          <div id="options" class="options" role="radiogroup" aria-label="Antwoorden"></div>
          <div class="exam-actions">
            <button id="previous" class="secondary-button" type="button">← Vorige</button>
            <button id="next" class="primary-button" type="button">Volgende <span>→</span></button>
          </div>
          <button id="finish" class="finish-button" type="button">Examen afronden</button>
        </section>

        <section class="question-overview" aria-label="Vraagoverzicht">
          <div class="overview-heading">
            <span>Vraagoverzicht · <b id="answeredCount">0</b> / {examLength} beantwoord</span>
            <span class="legend"><i class="answered-dot"></i> Beantwoord <i class="visited-dot"></i> Bekeken</span>
          </div>
          <nav id="questionNav" class="question-nav" aria-label="Vragennavigatie"></nav>
        </section>
      </section>

      <section id="results" class="results-card" hidden aria-live="polite">
        <p class="eyebrow"><span class="dot"></span> Resultaat</p>
        <h1><span id="correctCount">0</span> / {examLength} goed</h1>
        <p id="verdict" class="verdict"></p>
        <p id="resultSummary" class="lead"></p>
        <div id="review" class="review"></div>
        <button id="restart" class="primary-button" type="button">Nieuw oefenexamen <span>↻</span></button>
      </section>
    </div>
    </main>
  </body>
</html>

<script>
  import bank from '../data/knm-oefenexamens.json';
  import { buildExam, examDurationMinutes, examLength, passMark, scoreExam } from '../lib/knm.js';

  const $ = (selector) => document.querySelector(selector);
  const intro = $('#intro');
  const exam = $('#exam');
  const results = $('#results');
  const timer = $('#timer');
  const question = $('#question');
  const options = $('#options');
  const progress = $('#progress');
  const progressBar = $('#progressBar');
  const nav = $('#questionNav');
  const previous = $('#previous');
  const next = $('#next');
  const finish = $('#finish');
  const answeredCount = $('#answeredCount');
  const testChoice = $('#testChoice');
  let questions = [];
  let answers = [];
  let index = 0;
  let deadline = 0;
  let clock = null;
  let visited = new Set();

  function formatTime(milliseconds) {
    const seconds = Math.max(0, Math.ceil(milliseconds / 1000));
    return `${String(Math.floor(seconds / 60)).padStart(2, '0')}:${String(seconds % 60).padStart(2, '0')}`;
  }

  function updateTimer() {
    const remaining = deadline - Date.now();
    timer.textContent = formatTime(remaining);
    timer.classList.toggle('urgent', remaining <= 5 * 60 * 1000);
    if (remaining <= 0) completeExam();
  }

  function renderQuestion() {
    const item = questions[index];
    visited.add(index);
    progress.textContent = `Vraag ${index + 1} van ${examLength}`;
    progressBar.style.width = `${((index + 1) / examLength) * 100}%`;
    question.textContent = item.prompt;
    options.replaceChildren(...item.options.map((option) => {
      const label = document.createElement('label');
      label.className = 'option';
      const input = document.createElement('input');
      input.type = 'radio';
      input.name = 'answer';
      input.value = option.id;
      input.checked = answers[index] === option.id;
      input.addEventListener('change', () => {
        answers[index] = option.id;
        renderNav();
      });
      const letter = document.createElement('span');
      letter.className = 'option-letter';
      letter.textContent = option.id;
      const text = document.createElement('span');
      text.textContent = option.text;
      label.append(input, letter, text);
      return label;
    }));
    previous.disabled = index === 0;
    next.textContent = index === examLength - 1 ? 'Naar afronden →' : 'Volgende →';
    renderNav();
  }

  function renderNav() {
    answeredCount.textContent = String(answers.filter(Boolean).length);
    nav.replaceChildren(...questions.map((_, questionIndex) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.textContent = String(questionIndex + 1);
      button.classList.toggle('active', questionIndex === index);
      button.classList.toggle('answered', Boolean(answers[questionIndex]));
      button.classList.toggle('visited', visited.has(questionIndex) && !answers[questionIndex]);
      button.setAttribute('aria-label', `Vraag ${questionIndex + 1}`);
      button.addEventListener('click', () => { index = questionIndex; renderQuestion(); });
      return button;
    }));
  }

  function startExam() {
    questions = buildExam(bank.questions, { test: Number(testChoice.value) || null });
    answers = Array(examLength).fill(null);
    visited = new Set();
    index = 0;
    deadline = Date.now() + examDurationMinutes * 60 * 1000;
    intro.hidden = true;
    results.hidden = true;
    exam.hidden = false;
    clearInterval(clock);
    clock = setInterval(updateTimer, 1000);
    updateTimer();
    renderQuestion();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function completeExam() {
    clearInterval(clock);
    const { correct, passed } = scoreExam(questions, answers);
    exam.hidden = true;
    results.hidden = false;
    $('#correctCount').textContent = String(correct);
    const verdict = $('#verdict');
    verdict.textContent = passed ? 'Geslaagd' : 'Niet geslaagd';
    verdict.classList.toggle('passed', passed);
    $('#resultSummary').textContent = `${correct} van ${examLength} antwoorden zijn correct. Om te slagen heeft u minimaal ${passMark} goede antwoorden nodig. ${passed ? 'Goed gedaan!' : 'Bekijk de antwoorden en probeer daarna een nieuw oefenexamen.'}`;
    $('#review').replaceChildren(...questions.map((item, questionIndex) => {
      const selected = answers[questionIndex];
      const selectedOption = item.options.find((option) => option.id === selected)?.text || 'Niet beantwoord';
      const correctOption = item.options.find((option) => option.id === item.correct).text;
      const article = document.createElement('article');
      article.className = `review-item ${selected === item.correct ? 'correct' : 'incorrect'}`;
      const title = document.createElement('strong');
      title.textContent = `${questionIndex + 1}. ${item.prompt}`;
      const mine = document.createElement('p');
      mine.textContent = `Jouw antwoord: ${selected || '—'} — ${selectedOption}`;
      article.append(title, mine);
      if (selected !== item.correct) {
        const right = document.createElement('p');
        right.textContent = `Goed antwoord: ${item.correct} — ${correctOption}`;
        article.append(right);
      }
      const source = document.createElement('small');
      source.textContent = `Oefentoets ${String(item.test).padStart(3, '0')} · vraag ${item.number}`;
      article.append(source);
      return article;
    }));
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  $('#startExam').addEventListener('click', startExam);
  $('#restart').addEventListener('click', () => { results.hidden = true; intro.hidden = false; window.scrollTo({ top: 0, behavior: 'smooth' }); });
  previous.addEventListener('click', () => { if (index > 0) { index -= 1; renderQuestion(); } });
  next.addEventListener('click', () => { if (index < examLength - 1) { index += 1; renderQuestion(); } else finish.focus(); });
  finish.addEventListener('click', () => {
    const open = answers.filter((answer) => !answer).length;
    if (open && !confirm(`U heeft nog ${open} vragen niet beantwoord. Examen afronden?`)) return;
    completeExam();
  });
</script>

<style is:global>
  .knm-page { padding-top: clamp(96px, 12vw, 150px); }
  .knm-shell { max-width: 860px; }
  .intro-card, .results-card, .question-card { border: 1px solid var(--hairline); background: var(--glass); box-shadow: var(--inner-light); border-radius: var(--r-shell); }
  .intro-card, .results-card { padding: clamp(28px, 6vw, 72px); }
  h1 { font-size: var(--fs-h1); margin: var(--sp-5) 0; }
  h1 em { color: var(--accent); font-style: normal; }
  .lead { max-width: 58ch; color: var(--text-muted); font-size: var(--fs-lead); }
  .exam-rules { display: flex; flex-wrap: wrap; gap: var(--sp-3); margin: var(--sp-7) 0 var(--sp-5); color: var(--text-dim); font-family: var(--font-mono); font-size: .78rem; }
  .exam-rules span { padding: 9px 12px; border: 1px solid var(--hairline); border-radius: 999px; }
  .test-select { display: grid; gap: 8px; max-width: 420px; margin-bottom: var(--sp-6); color: var(--text-faint); font-family: var(--font-mono); font-size: .72rem; text-transform: uppercase; letter-spacing: .12em; }
  .test-select select { font: inherit; font-family: var(--font-sans); font-size: .95rem; text-transform: none; letter-spacing: 0; color: var(--text); background: var(--bg-core); border: 1px solid var(--hairline); border-radius: var(--r-core-sm); padding: 11px 14px; }
  button { font: inherit; cursor: pointer; }
  .primary-button, .secondary-button { border-radius: 999px; padding: 12px 18px; border: 1px solid var(--hairline); font-weight: 600; }
  .primary-button { background: var(--accent); color: var(--accent-ink); border-color: transparent; }
  .primary-button span { margin-left: 8px; }
  .secondary-button { color: var(--text); background: transparent; }
  .source-note { margin-top: var(--sp-5); color: var(--text-faint); font-size: .82rem; }
  .exam-header { display: flex; justify-content: space-between; align-items: center; gap: var(--sp-4); margin-bottom: var(--sp-4); }
  .kicker, .question-label { color: var(--text-faint); text-transform: uppercase; font-family: var(--font-mono); font-size: .72rem; letter-spacing: .12em; }
  .timer { min-width: 96px; text-align: center; border: 1px solid var(--hairline); background: var(--bg-core); border-radius: 999px; padding: 8px 14px; font-family: var(--font-mono); font-size: 1.2rem; }
  .timer.urgent { color: #fca5a5; border-color: rgba(252,165,165,.5); }
  .progress-track { height: 3px; background: var(--hairline); border-radius: 99px; margin-bottom: var(--sp-6); overflow: hidden; }
  .progress-track span { display: block; height: 100%; width: 0; background: var(--accent); transition: width .25s ease; }
  .question-card { padding: var(--sp-6); }
  .finish-button { border: 0; background: none; color: var(--accent); font-size: .8rem; display: block; margin: var(--sp-5) auto 0; }
  h2 { font-family: var(--font-sans); font-size: clamp(1.2rem, 2vw, 1.5rem); line-height: 1.35; margin: var(--sp-3) 0 var(--sp-5); }
  .options { display: grid; gap: var(--sp-3); }
  .option { display: grid; grid-template-columns: 34px minmax(0, 1fr); column-gap: 16px; align-items: center; border: 1px solid var(--hairline); border-radius: var(--r-core-sm); padding: 11px 14px; color: var(--text-muted); transition: border-color .2s, background .2s; cursor: pointer; }
  .option:hover { border-color: var(--hairline-strong); background: var(--glass-strong); }
  .option:has(input:checked) { border-color: var(--accent); background: var(--accent-dim); color: var(--text); }
  .option input { position: absolute; opacity: 0; }
  .option-letter { width: 30px; height: 30px; display: grid; place-items: center; border: 1px solid currentColor; border-radius: 50%; font-family: var(--font-mono); font-size: .8rem; }
  .option > span:last-child { display: block; min-width: 0; padding-left: 6px; }
  .exam-actions { display: flex; justify-content: space-between; gap: var(--sp-3); margin-top: var(--sp-6); }
  .secondary-button:disabled { opacity: .35; cursor: not-allowed; }
  .question-overview { margin-top: var(--sp-6); padding: var(--sp-4); border: 1px solid var(--hairline); border-radius: var(--r-core-sm); background: rgba(255,255,255,.018); }
  .overview-heading { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-3); margin-bottom: var(--sp-3); color: var(--text-dim); font-size: .8rem; }
  .legend { display: inline-flex; align-items: center; gap: 7px; color: var(--text-faint); font-size: .72rem; }
  .legend i { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-left: 5px; }
  .answered-dot { background: var(--accent); box-shadow: 0 0 7px var(--accent-glow); }
  .visited-dot { background: #fbbf24; box-shadow: 0 0 7px rgba(251,191,36,.5); }
  .question-nav { display: grid; grid-template-columns: repeat(auto-fill, minmax(38px, 1fr)); gap: 8px; }
  .question-nav button { height: 38px; border-radius: 10px; border: 1px solid var(--hairline); color: var(--text-dim); background: var(--bg-core); font-family: var(--font-mono); font-size: .76rem; transition: transform .15s ease, border-color .15s ease, background .15s ease; }
  .question-nav button:hover { transform: translateY(-1px); border-color: var(--hairline-strong); }
  .question-nav button.answered { border-color: rgba(94,234,212,.65); background: rgba(94,234,212,.12); color: var(--accent-hi); }
  .question-nav button.visited { border-color: rgba(251,191,36,.75); background: rgba(251,191,36,.11); color: #fde68a; }
  .question-nav button.active { outline: 2px solid var(--text); outline-offset: 2px; }
  .verdict { display: inline-block; padding: 6px 14px; border-radius: 999px; font-weight: 600; color: #fb7185; border: 1px solid rgba(251,113,133,.5); margin-bottom: var(--sp-4); }
  .verdict.passed { color: var(--accent); border-color: var(--accent); }
  .review { display: grid; gap: var(--sp-3); margin: var(--sp-7) 0; }
  .review-item { border-left: 3px solid var(--hairline); padding: var(--sp-4); background: var(--glass); border-radius: 0 var(--r-core-sm) var(--r-core-sm) 0; }
  .review-item.correct { border-color: var(--accent); }
  .review-item.incorrect { border-color: #fb7185; }
  .review-item p { margin-top: 6px; color: var(--text-dim); font-size: .9rem; }
  .review-item small { display: block; margin-top: 6px; color: var(--text-faint); font-family: var(--font-mono); font-size: .7rem; }
  @media (max-width: 760px) { .exam-header { align-items: flex-start; } .timer { min-width: auto; } .intro-card, .results-card, .question-card { padding: var(--sp-5); } }
</style>
