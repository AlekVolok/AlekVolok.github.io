---
import '../styles/global.css';
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#050505" />
    <meta name="robots" content="noindex" />
    <title>Inburgering A2 · Spreken</title>
  </head>
  <body>
    <main class="section spreken-page">
    <div class="container spreken-shell">
      <section id="intro" class="intro-card">
        <p class="eyebrow"><span class="dot"></span> Inburgering · A2</p>
        <h1>Spreken<br /><em>oefenexamen</em></h1>
        <p class="lead"><span id="questionCount"></span> vragen · 45 minuten · je antwoord wordt opgenomen en daarna beoordeeld.</p>
        <ol class="block-list" id="blockList"></ol>
        <p id="support" class="support-note" hidden></p>
        <button id="startExam" class="primary-button" type="button">Start oefenexamen <span>→</span></button>
        <p class="source-note">Opgaven: Ad Appel Taaltrainingen · dit is een oefentrainer, geen officieel DUO-examen.</p>
      </section>

      <section id="exam" class="exam" hidden aria-live="polite">
        <header class="exam-header">
          <div>
            <p class="kicker">A2 · Spreekvaardigheid</p>
            <strong id="progress"></strong>
          </div>
          <div class="timers">
            <div id="examTimer" class="timer" aria-label="Resterende tijd voor het examen">45:00</div>
            <div id="questionTimer" class="timer small" aria-label="Voorgestelde tijd voor deze vraag">00:00</div>
          </div>
        </header>

        <div class="progress-track" aria-hidden="true"><span id="progressBar"></span></div>

        <div class="exam-grid">
          <section class="question-card">
            <p class="kicker" id="blockLabel"></p>
            <p id="instruction" class="instruction"></p>

            <div id="audioBox" class="audio-box" hidden>
              <p class="hint">Luister naar de vraag. De tekst zie je na het examen.</p>
              <audio id="questionAudio" controls preload="none"></audio>
            </div>

            <div id="pictureBox" class="picture-grid" hidden></div>
            <h2 id="questionText" class="question-text" hidden></h2>

            <div class="record-row">
              <button id="record" class="record-button" type="button" aria-pressed="false">
                <span class="record-dot" aria-hidden="true"></span><span id="recordLabel">Start opname</span>
              </button>
              <span id="recordStatus" class="record-status" aria-live="polite"></span>
            </div>

            <label class="transcript-label" for="transcript">Transcript (bewerkbaar)</label>
            <textarea id="transcript" class="transcript" rows="4" placeholder="Het transcript verschijnt na het stoppen van de opname. Je kunt je antwoord ook typen."></textarea>
            <audio id="playback" class="playback" controls hidden></audio>

            <div class="exam-actions">
              <button id="previous" class="secondary-button" type="button">← Vorige</button>
              <button id="next" class="primary-button" type="button">Volgende <span>→</span></button>
            </div>
            <button id="finish" class="finish-button" type="button">Examen afronden</button>
          </section>
        </div>

        <section class="question-overview" aria-label="Vraagoverzicht">
          <div class="overview-heading"><span>Vragen</span></div>
          <nav id="questionNav" class="question-nav" aria-label="Vragennavigatie"></nav>
        </section>
      </section>

      <section id="results" class="results-card" hidden aria-live="polite">
        <p class="eyebrow"><span class="dot"></span> Resultaat</p>
        <h1 id="averageScore">Bezig met beoordelen…</h1>
        <p id="resultSummary" class="lead"></p>
        <div id="review" class="review"></div>
        <div class="result-actions">
          <button id="regrade" class="secondary-button" type="button" hidden>Opnieuw beoordelen</button>
          <button id="download" class="secondary-button" type="button" hidden>Download rapport (.md)</button>
          <button id="restart" class="primary-button" type="button">Nieuw oefenexamen <span>↻</span></button>
        </div>
      </section>
    </div>
    </main>
  </body>
</html>

<script>
  import config from '../data/spreken-config.json';
  import audioPool from '../data/spreken-audio.json';
  import picturePool from '../data/spreken-pictures.json';
  import { createRecording, requestMicrophone } from '../lib/spreken-recording.js';
  import { assessPass, buildExam, buildEvaluationPayload, buildReportMarkdown, encodeMp3, parseEvaluation, verdictLabels } from '../lib/spreken.js';

  const $ = (selector) => document.querySelector(selector);
  const intro = $('#intro');
  const exam = $('#exam');
  const results = $('#results');
  const progress = $('#progress');
  const progressBar = $('#progressBar');
  const examTimer = $('#examTimer');
  const questionTimer = $('#questionTimer');
  const blockLabel = $('#blockLabel');
  const instruction = $('#instruction');
  const audioBox = $('#audioBox');
  const questionAudio = $('#questionAudio');
  const pictureBox = $('#pictureBox');
  const questionText = $('#questionText');
  const transcriptBox = $('#transcript');
  const playback = $('#playback');
  const recordButton = $('#record');
  const recordLabel = $('#recordLabel');
  const recordStatus = $('#recordStatus');
  const questionNav = $('#questionNav');
  const previous = $('#previous');
  const next = $('#next');
  const finish = $('#finish');

  const canRecord = Boolean(navigator.mediaDevices?.getUserMedia && window.MediaRecorder);
  const examDurationMs = config.examMinutes * 60 * 1000;

  let questions = [];
  let answers = [];
  let index = 0;
  let deadline = 0;
  let clock = null;
  let countdown = null;
  let recording = null;
  let startingRecording = null;
  let completing = false;

  $('#questionCount').textContent = String(config.blocks.reduce((sum, block) => sum + block.count, 0));
  $('#blockList').replaceChildren(...config.blocks.map((block) => {
    const item = document.createElement('li');
    item.textContent = `${block.title} — ${block.count} vragen · ${block.instruction}`;
    return item;
  }));
  if (!canRecord) {
    $('#support').hidden = false;
    $('#support').textContent = 'Deze browser kan geen audio opnemen. Je kunt je antwoord wel typen.';
  }

  function formatTime(milliseconds) {
    const seconds = Math.max(0, Math.ceil(milliseconds / 1000));
    return `${String(Math.floor(seconds / 60)).padStart(2, '0')}:${String(seconds % 60).padStart(2, '0')}`;
  }

  function updateExamTimer() {
    const remaining = deadline - Date.now();
    examTimer.textContent = formatTime(remaining);
    examTimer.classList.toggle('urgent', remaining <= 5 * 60 * 1000);
    if (remaining <= 0) completeExam();
  }

  async function stopRecording() {
    if (startingRecording) await startingRecording;
    clearInterval(countdown);
    const current = recording;
    if (current) {
      await current.stop();
      if (recording === current) recording = null;
    }
    recordButton.setAttribute('aria-pressed', 'false');
    recordButton.classList.remove('recording');
    recordLabel.textContent = 'Start opname';
  }

  function showPlayback(answer) {
    if (answer.audioUrl) {
      playback.src = answer.audioUrl;
      playback.hidden = false;
    } else {
      playback.removeAttribute('src');
      playback.hidden = true;
    }
  }

  function renderQuestion() {
    const item = questions[index];
    const answer = answers[index];
    const isAudio = item.pictureCount === 0;
    progress.textContent = `Vraag ${index + 1} van ${questions.length}`;
    progressBar.style.width = `${((index + 1) / questions.length) * 100}%`;
    blockLabel.textContent = item.blockTitle;
    instruction.textContent = item.instruction;

    audioBox.hidden = !isAudio;
    if (isAudio) {
      questionAudio.src = item.audio;
    } else {
      questionAudio.removeAttribute('src');
    }

    pictureBox.hidden = isAudio;
    pictureBox.replaceChildren(...(isAudio ? [] : item.pictures.map((src, pictureIndex) => {
      const image = document.createElement('img');
      image.src = src;
      image.alt = `Plaatje ${pictureIndex + 1} bij vraag ${index + 1}`;
      image.loading = 'lazy';
      return image;
    })));
    pictureBox.dataset.count = String(item.pictures?.length || 0);

    questionText.hidden = isAudio;
    questionText.textContent = isAudio ? '' : item.question;

    transcriptBox.value = answer.transcript;
    showPlayback(answer);
    clearInterval(countdown);
    questionTimer.textContent = formatTime(item.seconds * 1000);
    questionTimer.classList.remove('urgent');
    recordStatus.textContent = answer.recordingError || '';
    previous.disabled = index === 0;
    next.textContent = index === questions.length - 1 ? 'Naar afronden →' : 'Volgende →';
    renderNav();
  }

  function renderNav() {
    questionNav.replaceChildren(...questions.map((_, questionIndex) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.textContent = String(questionIndex + 1);
      button.classList.toggle('active', questionIndex === index);
      button.classList.toggle('answered', Boolean(answers[questionIndex].transcript.trim() || answers[questionIndex].audioBlob));
      button.setAttribute('aria-label', `Vraag ${questionIndex + 1}`);
      button.addEventListener('click', () => navigateTo(questionIndex));
      return button;
    }));
  }

  async function startRecording() {
    const answer = answers[index];
    const questionIndex = index;
    const item = questions[index];
    // Pause question/playback audio before opening the microphone on mobile.
    questionAudio.pause();
    playback.pause();
    recordLabel.textContent = 'Microfoon openen…';
    recordStatus.textContent = 'Sta microfoontoegang toe als de browser daarom vraagt.';
    let currentStream;
    try {
      currentStream = await requestMicrophone((constraints) => navigator.mediaDevices.getUserMedia(constraints));
    } catch (error) {
      const message = error.name === 'NotFoundError'
        ? 'Geen microfoon gevonden. Sluit een microfoon aan en probeer opnieuw.'
        : error.name === 'NotReadableError'
          ? 'De microfoon is bezet. Sluit andere opnames of gesprekken en probeer opnieuw.'
          : error.name === 'NotAllowedError'
            ? 'Geen toegang tot de microfoon. Sta microfoontoegang toe voor deze website.'
            : error.message || 'De microfoon kan niet worden geopend. Probeer opnieuw.';
      if (!answer.audioBlob) answer.recordingError = message;
      recordStatus.textContent = message;
      return;
    }
    let current;
    try {
      current = createRecording(currentStream);
    } catch {
      const message = 'Opnemen lukt niet. Probeer opnieuw of gebruik een andere browser.';
      if (!answer.audioBlob) answer.recordingError = message;
      recordStatus.textContent = message;
      return;
    }
    recording = current;
    // A new recording replaces the previous answer, including its transcript, audio and grading.
    answer.transcript = '';
    answer.audioBlob = null;
    if (answer.audioUrl) URL.revokeObjectURL(answer.audioUrl);
    answer.audioUrl = '';
    answer.recordingError = '';
    answer.mimeType = '';
    answer.grading = null;
    transcriptBox.value = '';
    showPlayback(answer);
    renderNav();
    current.done.then(({ blob, error }) => {
      answer.audioBlob = blob;
      answer.mimeType = blob?.type || '';
      answer.audioUrl = blob ? URL.createObjectURL(blob) : '';
      answer.recordingError = error?.message || '';
      if (recording === current) {
        clearInterval(countdown);
        recordButton.setAttribute('aria-pressed', 'false');
        recordButton.classList.remove('recording');
        recordLabel.textContent = 'Start opname';
        recording = null;
      }
      if (answers[index] === answer) {
        showPlayback(answer);
        recordStatus.textContent = error?.message || 'Opname opgeslagen. Je kunt hem hieronder beluisteren.';
      }
      renderNav();
      if (blob) {
        const transcriptAtStop = answer.transcript;
        const grading = enqueueGrade(questionIndex);
        if (answers[index] === answer) recordStatus.textContent = 'Opname opgeslagen. Je kunt hem beluisteren; het transcript wordt gemaakt…';
        grading.then(({ result, error: gradingError }) => {
          if (answer.grading !== grading) return;
          // Do not overwrite a typed correction, a newer recording or another exam.
          if (result?.transcript && answer.transcript === transcriptAtStop) {
            answer.transcript = result.transcript;
            if (answers[index] === answer) transcriptBox.value = answer.transcript;
          }
          if (answers[index] === answer && !recording) {
            recordStatus.textContent = gradingError
              ? `Opname opgeslagen. ${gradingError}`
              : 'Opname en transcript opgeslagen. Je kunt de opname beluisteren.';
          }
        });
      }
    });
    recordButton.setAttribute('aria-pressed', 'true');
    recordButton.classList.add('recording');
    recordLabel.textContent = 'Stop opname';
    recordStatus.textContent = 'Aan het opnemen… Het transcript verschijnt na het stoppen.';

    // The per-question timer is a suggestion: it warns but never stops the recording.
    const startedAt = Date.now();
    clearInterval(countdown);
    countdown = setInterval(() => {
      const left = item.seconds * 1000 - (Date.now() - startedAt);
      questionTimer.textContent = formatTime(left);
      questionTimer.classList.toggle('urgent', left <= 10000);
    }, 250);
  }

  async function toggleRecording() {
    if (!canRecord || startingRecording || recordButton.disabled) return;
    recordButton.disabled = true;
    try {
      if (recording) await stopRecording();
      else {
        startingRecording = startRecording();
        await startingRecording;
      }
    } finally {
      startingRecording = null;
      recordButton.disabled = false;
      if (!recording) recordLabel.textContent = 'Start opname';
    }
  }

  async function navigateTo(questionIndex) {
    if (completing) return;
    await stopRecording();
    if (completing) return;
    index = questionIndex;
    renderQuestion();
  }

  function blobToBase64(blob) {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(String(reader.result).split(',')[1]);
      reader.onerror = reject;
      reader.readAsDataURL(blob);
    });
  }

  // The n8n server rejects request bodies over about 1 MB (HTTP 413, which the browser
  // reports as "Failed to fetch"). Recordings are therefore resampled to 16 kHz mono
  // and encoded as 32 kbps MP3.
  const maxBodyBytes = 950 * 1024;
  const speechSampleRate = 16000;

  async function toMp3(blob) {
    const context = new AudioContext();
    try {
      const decoded = await context.decodeAudioData(await blob.arrayBuffer());
      const frames = Math.ceil(decoded.duration * speechSampleRate);
      const offline = new OfflineAudioContext(1, frames, speechSampleRate);
      const source = offline.createBufferSource();
      source.buffer = decoded;
      source.connect(offline.destination);
      source.start();
      const rendered = await offline.startRendering();
      return new Blob([encodeMp3(rendered.getChannelData(0), speechSampleRate)], { type: 'audio/mpeg' });
    } finally {
      context.close();
    }
  }

  async function evaluate(item, answer) {
    if (answer.recordingError) throw new Error(answer.recordingError);
    let audioBlob = answer.audioBlob;
    if (audioBlob) {
      try {
        audioBlob = await toMp3(audioBlob);
      } catch {
        // Keep the original recording if this browser cannot decode it.
      }
    }
    // Pictures are not sent: each slide has a written Dutch description in
    // spreken-pictures.json, which the payload carries as pictureDescription.
    const body = buildEvaluationPayload(item, {
      audioBase64: audioBlob ? await blobToBase64(audioBlob) : '',
      mimeType: audioBlob ? audioBlob.type : '',
      transcriptHint: answer.transcript,
    });
    const json = JSON.stringify(body);
    if (json.length > maxBodyBytes) {
      throw new Error('De opname is te lang om te beoordelen. Probeer een korter antwoord.');
    }
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 300000);
    try {
      const response = await fetch(config.evaluateUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: json,
        signal: controller.signal,
      });
      if (!response.ok) throw new Error(`Webhook gaf status ${response.status}`);
      const result = parseEvaluation(await response.text());
      if (audioBlob && !result.error && !result.transcript.trim()) {
        throw new Error('De opname is opgeslagen, maar er is geen betrouwbaar transcript. Probeer opnieuw te beoordelen.');
      }
      return result;
    } finally {
      clearTimeout(timeout);
    }
  }

  function renderResults(entries) {
    const scored = entries.filter((entry) => entry.result);
    const average = scored.length ? scored.reduce((sum, entry) => sum + entry.result.score, 0) / scored.length : 0;
    $('#averageScore').textContent = scored.length ? `${average.toFixed(1)} / 10` : 'Geen beoordeling';
    const pass = assessPass(entries, config.passRule);
    $('#resultSummary').textContent = `${pass.pending ? `Nog geen volledige uitslag: ${pass.pending} antwoorden niet beoordeeld` : (pass.passed ? 'Mogelijk geslaagd' : 'Mogelijk niet geslaagd')}: ${pass.answered} van ${pass.total} antwoorden goed (nodig: ${pass.required}). ${pass.note}`;

    const review = $('#review');
    review.replaceChildren(...entries.map((entry, entryIndex) => {
      const { item, result } = entry;
      const article = document.createElement('article');
      article.className = `review-item ${result && result.score >= 6 ? 'correct' : 'incorrect'}`;

      const heading = document.createElement('strong');
      heading.textContent = `Vraag ${entryIndex + 1} · ${item.title}`;
      const status = document.createElement('p');
      status.className = 'kicker';
      status.textContent = `${item.blockTitle}${result ? ` · ${result.score} / 10 · ${verdictLabels[result.verdict]}` : ''}`;
      article.append(status);
      const questionLine = document.createElement('p');
      questionLine.textContent = `Vraag: ${item.question}`;
      const transcriptLine = document.createElement('p');
      transcriptLine.textContent = `Jouw antwoord: ${(result?.transcript || entry.transcript).trim() || '—'}`;
      article.append(heading, questionLine, transcriptLine);
      if (entry.audioUrl) {
        const ownAudio = document.createElement('audio');
        ownAudio.controls = true;
        ownAudio.src = entry.audioUrl;
        ownAudio.preload = 'none';
        article.append(ownAudio);
      }

      if (result?.proposedAnswer) {
        const proposal = document.createElement('p');
        proposal.className = 'proposal';
        proposal.textContent = `Voorstel: ${result.proposedAnswer}`;
        article.append(proposal);
      }
      if (item.modelAnswer) {
        const model = document.createElement('p');
        model.textContent = `Voorbeeldantwoord: ${item.modelAnswer}`;
        article.append(model);
      }
      if (item.modelAudio) {
        const modelAudio = document.createElement('audio');
        modelAudio.controls = true;
        modelAudio.preload = 'none';
        modelAudio.src = item.modelAudio;
        modelAudio.className = 'playback';
        article.append(modelAudio);
      }
      if (entry.error) {
        const errorLine = document.createElement('p');
        errorLine.textContent = entry.error;
        article.append(errorLine);
      }
      if (result) {
        if (result.mistakes.length) {
          const mistakes = document.createElement('ul');
          result.mistakes.forEach((mistake) => {
            const li = document.createElement('li');
            li.textContent = `"${mistake.original}" → ${mistake.correction}${mistake.explanation ? ` (${mistake.explanation})` : ''}`;
            mistakes.append(li);
          });
          article.append(mistakes);
        }
        if (result.feedback) {
          const feedback = document.createElement('p');
          feedback.textContent = result.feedback;
          article.append(feedback);
        }
      }
      return article;
    }));

    const download = $('#download');
    download.hidden = false;
    download.onclick = () => {
      const blob = new Blob([buildReportMarkdown(entries, config.passRule)], { type: 'text/markdown' });
      const link = document.createElement('a');
      link.href = URL.createObjectURL(blob);
      link.download = `spreken-a2-${new Date().toISOString().slice(0, 10)}.md`;
      link.click();
      URL.revokeObjectURL(link.href);
    };
  }

  // Grading runs in the background while the exam is still going: each answer is queued
  // as soon as its recording stops, and at most three requests run at the same time.
  const gradeQueue = [];
  let gradesRunning = 0;

  function pumpGrades() {
    while (gradesRunning < 3 && gradeQueue.length) {
      const job = gradeQueue.shift();
      gradesRunning += 1;
      job().finally(() => {
        gradesRunning -= 1;
        pumpGrades();
      });
    }
  }

  // Retries once on a network error (the browser reports these as "Failed to fetch").
  const unreachableMessage = 'De beoordelingsserver is niet bereikbaar (netwerk of DNS). Probeer het later opnieuw met "Opnieuw beoordelen".';

  async function gradeWithRetry(item, answer) {
    for (let attempt = 1; attempt <= 2; attempt += 1) {
      try {
        const result = await evaluate(item, answer);
        return { result: result.error ? null : result, error: result.error || '' };
      } catch (error) {
        if (error.name === 'AbortError') return { result: null, error: 'Beoordeling duurde te lang.' };
        if (attempt === 2 && error.name === 'TypeError') return { result: null, error: unreachableMessage };
        if (error.name !== 'TypeError') return { result: null, error: error.message };
        await new Promise((resolve) => setTimeout(resolve, 2000));
      }
    }
    return { result: null, error: 'Beoordeling mislukt.' };
  }

  function enqueueGrade(questionIndex) {
    const answer = answers[questionIndex];
    if (!answer.grading) {
      const snapshot = { ...answer };
      const item = questions[questionIndex];
      answer.grading = new Promise((resolve) => {
        gradeQueue.push(async () => resolve(await gradeWithRetry(item, snapshot)));
        pumpGrades();
      });
    }
    return answer.grading;
  }

  async function completeExam() {
    if (completing) return;
    completing = true;
    clearInterval(clock);
    await stopRecording();
    exam.hidden = true;
    results.hidden = false;
    await gradeAll();
  }

  // Grades every answer (reusing gradings that already finished) and shows the results.
  // "Opnieuw beoordelen" calls this again after clearing the failed gradings.
  async function gradeAll() {
    $('#averageScore').textContent = 'Bezig met beoordelen…';
    $('#resultSummary').textContent = '';
    $('#download').hidden = true;
    $('#regrade').hidden = true;
    $('#review').replaceChildren();
    window.scrollTo({ top: 0, behavior: 'smooth' });

    // Empty answers are sent too: the grader proposes an answer for them.
    const entries = questions.map((item, questionIndex) => ({
      item,
      transcript: answers[questionIndex].transcript,
      audioUrl: answers[questionIndex].audioUrl,
      result: null,
      error: '',
    }));
    let finished = 0;
    const showProgress = () => {
      $('#averageScore').textContent = `Bezig met beoordelen… ${finished} van ${entries.length}`;
    };
    showProgress();

    await Promise.all(entries.map(async (entry, questionIndex) => {
      const outcome = await enqueueGrade(questionIndex);
      entry.result = outcome.result;
      entry.error = outcome.error;
      if (outcome.result) entry.transcript = outcome.result.transcript || entry.transcript;
      finished += 1;
      showProgress();
    }));
    renderResults(entries);
    const failed = entries.map((entry, questionIndex) => (entry.result ? -1 : questionIndex)).filter((i) => i >= 0);
    const regrade = $('#regrade');
    regrade.hidden = failed.length === 0;
    regrade.onclick = () => {
      failed.forEach((questionIndex) => { answers[questionIndex].grading = null; });
      gradeAll();
    };
  }

  function startExam() {
    answers.forEach((answer) => { if (answer.audioUrl) URL.revokeObjectURL(answer.audioUrl); });
    completing = false;
    questions = buildExam(config, audioPool, picturePool);
    answers = questions.map(() => ({ transcript: '', audioBlob: null, audioUrl: '', mimeType: '' }));
    index = 0;
    intro.hidden = true;
    results.hidden = true;
    exam.hidden = false;
    deadline = Date.now() + examDurationMs;
    clearInterval(clock);
    clock = setInterval(updateExamTimer, 1000);
    updateExamTimer();
    renderQuestion();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  $('#startExam').addEventListener('click', startExam);
  $('#restart').addEventListener('click', () => { results.hidden = true; intro.hidden = false; });
  recordButton.addEventListener('click', toggleRecording);
  transcriptBox.addEventListener('input', () => { answers[index].transcript = transcriptBox.value; answers[index].grading = null; renderNav(); });
  previous.addEventListener('click', () => { if (index > 0) navigateTo(index - 1); });
  next.addEventListener('click', () => { if (index < questions.length - 1) navigateTo(index + 1); else finish.focus(); });
  finish.addEventListener('click', completeExam);
</script>

<style is:global>
