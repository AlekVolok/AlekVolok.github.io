---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = new Intl.DateTimeFormat('en', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<Base title="Blog" description="Notes on Houdini, Python, procedural workflows and graphics programming.">
  <section class="section page-top">
    <div class="container">
      <span class="eyebrow reveal"><span class="dot"></span>Writing</span>
      <h1 class="page-title reveal" style="--i:1">Blog</h1>
      <p class="page-intro reveal" style="--i:2">
        Notes on Houdini, Python and graphics programming — things I wished
        someone had written down before I had to figure them out.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ul class="post-list">
        {posts.map((post, i) => (
          <li class="bezel interactive reveal" style={`--i:${i % 3}`}>
            <div class="core">
              <a href={`/blog/${post.id}`} class="row">
                <div class="meta">
                  <time datetime={post.data.date.toISOString()}>
                    {fmt.format(post.data.date)}
                  </time>
                </div>
                <div class="body">
                  <h2>{post.data.title}</h2>
                  <p>{post.data.description}</p>
                  <div class="tags">
                    {post.data.tags.map((t) => <span class="tag">{t}</span>)}
                  </div>
                </div>
                <span class="well" aria-hidden="true">
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 12L12 4M12 4H6M12 4v6" />
                  </svg>
                </span>
              </a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .page-top { padding-bottom: 0; padding-top: clamp(150px, 18vw, 220px); }
  .post-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    margin-top: var(--sp-8);
  }
  .row {
    display: grid;
    grid-template-columns: 130px 1fr auto;
    align-items: center;
    gap: var(--sp-5);
    padding: var(--sp-5) var(--sp-6);
    color: inherit;
  }
  .row:hover { text-decoration: none; }
  .meta time {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
    white-space: nowrap;
  }
  h2 {
    font-size: var(--fs-h3);
    margin-bottom: 6px;
    transition: color var(--dur) var(--ease-fluid);
  }
  .bezel:hover h2 { color: var(--accent); }
  .body p {
    color: var(--text-dim);
    font-size: 0.92rem;
    line-height: 1.6;
    margin-bottom: var(--sp-3);
    max-width: 62ch;
  }
  .well {
    width: 32px;
    height: 32px;
    flex: none;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--hairline);
    color: var(--text-dim);
    transition: transform var(--dur) var(--ease-fluid),
      background var(--dur) var(--ease-fluid), color var(--dur) var(--ease-fluid);
  }
  .well svg { width: 12px; height: 12px; }
  .bezel:hover .well,
  .bezel:focus-within .well {
    transform: translate(2px, -2px) scale(1.06);
    background: var(--accent);
    color: var(--accent-ink);
  }

  @media (max-width: 768px) {
    .row {
      grid-template-columns: 1fr;
      gap: var(--sp-3);
      padding: var(--sp-5);
    }
    .well { display: none; }
  }
</style>
